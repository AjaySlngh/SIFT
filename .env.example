# Postgres (docker-compose.yml maps the container's 5432 to host 55432 to
# avoid clashing with any Postgres already running locally on 5432)
DATABASE_URL=postgres://sift:sift@localhost:55432/sift

# MinIO (S3-compatible). docker-compose.yml runs adobe/s3mock as a stand-in
# since MinIO's OSS Docker images now require a licensed AIStor image — see
# the comment in docker-compose.yml. Swap the image if you have access to one.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sift-packages
S3_ACCESS_KEY_ID=sift
S3_SECRET_ACCESS_KEY=siftsiftsift
S3_FORCE_PATH_STYLE=true

# Anthropic
ANTHROPIC_API_KEY=
SIFT_MODEL_SPLIT=claude-haiku-4-5
SIFT_MODEL_CLASSIFY=claude-haiku-4-5
SIFT_MODEL_EXTRACT=claude-sonnet-4-5

# Web app
NEXTAUTH_SECRET=dev-secret-change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Worker
WORKER_POLL_INTERVAL_MS=1000
